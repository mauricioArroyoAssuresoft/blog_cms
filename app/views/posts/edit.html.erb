<h1>Edit Post</h1>

<%= form_with(model: @post) do |form| %>
  <% if @post.errors.any?() %>
    <ul>
      <% @post.errors().full_messages().each() do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
  
  <div>
    <%= form.label(:title) %>
    <%= form.text_field(:title) %>
  </div>

  <div>
    <%= form.label(:content) %>
    <%= form.text_area(:content) %>
  </div>

  <%= form.submit("Update Post") %>
<%end%>

<%= link_to("back to posts", posts_path())%>
